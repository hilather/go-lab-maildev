        "request_id",
        "message_id",
        "smtp_code",
        "capability",
        "result",
        "error_code",
        "duration_ms",
        "store_generation"
      ]
    },
    {
      "name": "state.apply",
      "fields": [
        "timestamp",
        "level",
        "event",
        "component",
        "request_id",
        "message_id",
        "smtp_code",
        "capability",
        "result",
        "error_code",
        "duration_ms",
        "store_generation"
      ]
    },
    {
      "name": "state.reset",
      "fields": [
        "timestamp",
        "level",
        "event",
        "component",
        "request_id",
        "message_id",
        "smtp_code",
        "capability",
        "result",
        "error_code",
        "duration_ms",
        "store_generation"
      ]
    },
    {
      "name": "store.deleted",
      "fields": [
        "timestamp",
        "level",
        "event",
        "component",
        "request_id",
        "message_id",
        "smtp_code",
        "capability",
        "result",
        "error_code",
        "duration_ms",
        "store_generation"
      ]
    },
    {
      "name": "store.full",
      "fields": [
        "timestamp",
        "level",
        "event",
        "component",
        "request_id",
