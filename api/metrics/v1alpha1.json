        "event",
        "component",
        "request_id",
        "message_id",
        "smtp_code",
        "capability",
        "result",
        "error_code",
        "duration_ms",
        "store_generation"
      ]
    },
    {
      "name": "smtp.session_end",
      "fields": [
        "timestamp",
