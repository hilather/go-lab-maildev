        "smtp_code",
        "capability",
        "result",
        "error_code",
        "duration_ms",
        "store_generation"
      ]
    },
    {
      "name": "store.inserted",
      "fields": [
        "timestamp",
        "level",
        "event",
        "component",
        "request_id",
        "message_id",
        "smtp_code",
        "capability",
        "result",
        "error_code",
        "duration_ms",
        "store_generation"
      ]
    },
    {
      "name": "store.wiped",
      "fields": [
        "timestamp",
        "level",
        "event",
        "component",
        "request_id",
        "message_id",
        "smtp_code",
        "capability",
        "result",
        "error_code",
        "duration_ms",
        "store_generation"
      ]
    }
  ]
}
